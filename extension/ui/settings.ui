<?xml version="1.0" encoding="UTF-8"?>
<!-- Écran de réglages (Glade / GTK3). Lu par ui_loader.load_ui, piloté par settings.py.
     Une case chk_<id> par action; un champ ent_shortcut_<id> pour les actions déclenchables au clavier. -->
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkBox" id="root">
    <property name="visible">True</property>
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="margin">10</property>
    <child>
      <object class="GtkNotebook" id="nb_settings">
        <property name="visible">True</property>
        <child>
          <object class="GtkBox" id="page_profil">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <property name="margin">8</property>
            <child>
              <object class="GtkLabel" id="lbl_profil_title">
                <property name="visible">True</property>
                <property name="label">Choisis un profil de départ. Tu pourras ensuite activer ou cacher chaque outil.</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
              </object>
            </child>
            <child>
              <object class="GtkComboBoxText" id="cmb_preset">
                <property name="visible">True</property>
                <property name="tooltip_text">Profil de départ</property>
                <items>
                  <item id="0">Simple</item>
                  <item id="1">Standard</item>
                  <item id="2">Complet</item>
                </items>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_settings_preset">
                <property name="visible">True</property>
                <property name="label">Appliquer ce profil aux cases</property>
                <property name="tooltip_text">Coche les outils du profil choisi (rien n'est enregistré avant « Enregistrer »)</property>
                <property name="height_request">44</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_preset_desc">
                <property name="visible">True</property>
                <property name="label"></property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
              </object>
            </child>
          </object>
        </child>
        <child type="tab">
          <object class="GtkLabel" id="tab_profil">
            <property name="visible">True</property>
            <property name="label">Profil</property>
            <property name="xalign">0</property>
          </object>
        </child>
        <child>
          <object class="GtkGrid" id="page_0">
            <property name="visible">True</property>
            <property name="row_spacing">4</property>
            <property name="column_spacing">12</property>
            <property name="margin">8</property>
            <child>
              <object class="GtkLabel" id="lbl_h_act_0">
                <property name="visible">True</property>
                <property name="label">Actif</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_h_sc_0">
                <property name="visible">True</property>
                <property name="label">Raccourci</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkCheckButton" id="chk_guide">
                <property name="visible">True</property>
                <property name="label">Guidage visuel</property>
                <property name="height_request">32</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkEntry" id="ent_shortcut_guide">
                <property name="visible">True</property>
                <property name="width_chars">14</property>
                <property name="tooltip_text">Séquence tapée (ex. //) ou combinaison (ex. Ctrl+Alt+G). Vide = pas de raccourci.</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkCheckButton" id="chk_align_equals">
                <property name="visible">True</property>
                <property name="label">Aligner les =</property>
                <property name="height_request">32</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">2</property>
              </packing>
            </child>
