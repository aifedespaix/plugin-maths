            </child>
            <child>
              <object class="GtkButton" id="btn_set_Z">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">ℤ</property>
                <property name="tooltip_text">Insérer l'ensemble des entiers relatifs [ clic ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">2</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkExpander" id="sec_modeles">
        <property name="visible">True</property>
        <property name="label">Modèles</property>
        <property name="expanded">False</property>
        <child>
          <object class="GtkGrid" id="grid_modeles">
            <property name="visible">True</property>
            <property name="row_spacing">6</property>
            <property name="column_spacing">6</property>
            <property name="column_homogeneous">True</property>
            <child>
              <object class="GtkButton" id="btn_tpl_equation_steps">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">Résoudre une équation</property>
                <property name="tooltip_text">Modèle : résoudre une équation [ clic ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_tpl_probleme">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">Problème</property>
                <property name="tooltip_text">Modèle : résoudre un problème [ clic ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_tpl_geometrie">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">Géométrie</property>
                <property name="tooltip_text">Modèle : démonstration de géométrie [ clic ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">2</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_tpl_fonction">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">Fonction</property>
                <property name="tooltip_text">Modèle : tableau de valeurs [ clic ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">3</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_tpl_calcul_litteral">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">Calcul littéral</property>
                <property name="tooltip_text">Modèle : développer et factoriser [ clic ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">4</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_tpl_propriete">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">Propriété</property>
                <property name="tooltip_text">Modèle : propriété, exemple, à retenir [ clic ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">5</property>
              </packing>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkExpander" id="sec_verif">
        <property name="visible">True</property>
        <property name="label">Vérifier</property>
        <property name="expanded">False</property>
        <child>
          <object class="GtkBox" id="box_verify">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel" id="lbl_verify_help">
                <property name="visible">True</property>
                <property name="label">Sélectionne une équation, puis entre la valeur à tester.</property>
                <property name="wrap">True</property>
                <property name="height_request">44</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="grid_verify">
                <property name="visible">True</property>
                <property name="row_spacing">4</property>
                <property name="column_spacing">6</property>
                <property name="column_homogeneous">True</property>
                <child>
                  <object class="GtkLabel" id="lbl_verify_var">
                    <property name="visible">True</property>
                    <property name="label">Variable</property>
                    <property name="height_request">22</property>
                  </object>
                  <packing>
                    <property name="left_attach">0</property>
                    <property name="top_attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_verify_value">
                    <property name="visible">True</property>
                    <property name="label">Valeur</property>
                    <property name="height_request">22</property>
                  </object>
                  <packing>
                    <property name="left_attach">1</property>
                    <property name="top_attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_verify_var">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="text">x</property>
                    <property name="tooltip_text">Nom de la variable (par exemple x)</property>
                    <property name="height_request">32</property>
                  </object>
                  <packing>
                    <property name="left_attach">0</property>
                    <property name="top_attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_verify_value">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="text"></property>
                    <property name="tooltip_text">Valeur à tester (par exemple 3 ou 1,5)</property>
                    <property name="height_request">32</property>
                  </object>
                  <packing>
                    <property name="left_attach">1</property>
                    <property name="top_attach">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_verify">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">Vérifier</property>
                <property name="tooltip_text">Vérifier l'égalité avec la valeur donnée [ clic ]</property>
                <property name="height_request">44</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_verify_result">
                <property name="visible">True</property>
                <property name="label"></property>
                <property name="wrap">True</property>
                <property name="height_request">48</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
