<?xml version="1.0" encoding="UTF-8"?>
<!-- Interface du panneau Maths (Glade / GTK3). Lue par ui_loader.py. Un bouton par action du catalogue:
     visibilite, infobulle (repli: tooltip_text), theme et recents sont pilotes par config.py. -->
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkBox" id="root">
    <property name="visible">True</property>
    <property name="orientation">vertical</property>
    <property name="spacing">10</property>
    <property name="margin">8</property>
    <child>
      <object class="GtkGrid" id="tools">
        <property name="visible">True</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkToggleButton" id="tgl_guide">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="label">Guidage</property>
            <property name="tooltip_text">Afficher ou masquer le guidage visuel [ Ctrl+Alt+G ]</property>
            <property name="height_request">40</property>
          </object>
          <packing>
            <property name="left_attach">0</property>
            <property name="top_attach">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="btn_align_equals">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="label">Aligner =</property>
            <property name="tooltip_text">Aligner les signes égal [ Ctrl+Alt+E ]</property>
            <property name="height_request">40</property>
          </object>
          <packing>
            <property name="left_attach">1</property>
            <property name="top_attach">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="btn_equation_step">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="label">Étape +</property>
            <property name="tooltip_text">Passer à l'étape suivante du calcul [ Ctrl+Alt+Return ]</property>
            <property name="height_request">40</property>
          </object>
          <packing>
            <property name="left_attach">0</property>
            <property name="top_attach">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="btn_open_settings">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="label">⚙ Réglages</property>
            <property name="tooltip_text">Ouvrir les réglages [ clic ]</property>
            <property name="height_request">40</property>
          </object>
          <packing>
            <property name="left_attach">1</property>
            <property name="top_attach">1</property>
          </packing>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="recents">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkLabel" id="lbl_recent">
            <property name="visible">True</property>
            <property name="label">Récents</property>
            <property name="height_request">22</property>
          </object>
        </child>
        <child>
          <object class="GtkGrid" id="grid_recent">
            <property name="visible">True</property>
            <property name="row_spacing">6</property>
            <property name="column_spacing">6</property>
            <property name="column_homogeneous">True</property>
            <child>
              <object class="GtkButton" id="btn_recent_0">
                <property name="visible">True</property>
                <property name="label">·</property>
                <property name="tooltip_text">Action récente</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_recent_1">
                <property name="visible">True</property>
                <property name="label">·</property>
                <property name="tooltip_text">Action récente</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_recent_2">
                <property name="visible">True</property>
                <property name="label">·</property>
                <property name="tooltip_text">Action récente</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">2</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_recent_3">
                <property name="visible">True</property>
                <property name="label">·</property>
                <property name="tooltip_text">Action récente</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_recent_4">
                <property name="visible">True</property>
                <property name="label">·</property>
                <property name="tooltip_text">Action récente</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_recent_5">
                <property name="visible">True</property>
                <property name="label">·</property>
                <property name="tooltip_text">Action récente</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">2</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkExpander" id="sec_nombres">
        <property name="visible">True</property>
        <property name="label">Nombres &amp; Opérations</property>
        <property name="expanded">False</property>
        <child>
          <object class="GtkGrid" id="grid_nombres">
            <property name="visible">True</property>
            <property name="row_spacing">6</property>
            <property name="column_spacing">6</property>
            <property name="column_homogeneous">True</property>
            <child>
              <object class="GtkButton" id="btn_times">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">×</property>
                <property name="tooltip_text">Insérer le signe multiplié [ clic ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_divide">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">÷</property>
                <property name="tooltip_text">Insérer le signe divisé [ clic ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_plus_minus">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">±</property>
                <property name="tooltip_text">Insérer plus ou moins [ +- ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">2</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_leq">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">≤</property>
                <property name="tooltip_text">Insérer inférieur ou égal [ &lt;= ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">3</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_geq">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">≥</property>
                <property name="tooltip_text">Insérer supérieur ou égal [ &gt;= ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_neq">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">≠</property>
                <property name="tooltip_text">Insérer différent de [ != ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_approx">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="label">≈</property>
                <property name="tooltip_text">Insérer environ égal [ ~= ]</property>
                <property name="height_request">44</property>
              </object>
              <packing>
                <property name="left_attach">2</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
